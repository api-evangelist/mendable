{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mendable Chat Conversations API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "api_key",
      "value": "{{api_key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Conversations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new conversation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mendable.ai/v1/newConversation",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new conversation and returns a conversation_id used to group subsequent chat interactions into a single grounded session."
        }
      ]
    }
  ],
  "bundled": true
}